APP_NAME="Darsu Store"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://website-penjualan-toko.test

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---- Database ----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=toko_online
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ---- Antrean (email dikirim lewat antrean; jalankan: php artisan queue:work) ----
# Pakai "sync" kalau tidak mau menjalankan worker (email dikirim langsung).
QUEUE_CONNECTION=database

# ---- Email ----
# MAIL_MAILER=log menulis email ke storage/logs/laravel.log (aman, tanpa kredensial).
# Untuk mengirim sungguhan lewat Gmail: ganti ke smtp lalu isi App Password (bukan password Gmail).
MAIL_MAILER=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# ---- Toko ----
SHOP_NAME="${APP_NAME}"
# Tujuan email untuk admin (pesanan baru, pembayaran diterima, pelanggan baru).
SHOP_ADMIN_EMAIL=
# Lokasi toko, dipakai untuk menentukan zona ongkos kirim.
SHOP_ORIGIN_CITY="Padang"
SHOP_ORIGIN_PROVINCE="Sumatera Barat"

# ---- Midtrans (sandbox). Server Key bersifat RAHASIA: jangan di-commit ----
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_EXPIRY_HOURS=24
MIDTRANS_VERIFY_SSL=true
# Isi "ngrok" untuk menerima webhook lewat ngrok (alamat dideteksi otomatis). Kosongkan kalau tidak dipakai.
MIDTRANS_NOTIFICATION_URL=

VITE_APP_NAME="${APP_NAME}"
